<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Install Buddy" Width="780" Height="550" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" Foreground="#323232">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="24,13"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#2F2F2F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="23" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#525252"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8B8B8B"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Margin="14" CornerRadius="26" Background="#F8F8F8" BorderBrush="#FFFFFF" BorderThickness="1">
  <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.14" Color="#303030"/></Border.Effect>
  <Grid ClipToBounds="True">
   <Canvas x:Name="Glyphs" IsHitTestVisible="False" Opacity="0.16"/>
   <Grid Margin="32,23,32,24">
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="104"/></Grid.RowDefinitions>
    <Grid x:Name="Caption" Background="Transparent"><StackPanel Orientation="Horizontal" VerticalAlignment="Top"><Image x:Name="BrandMark" Width="29" Height="29" Stretch="Uniform" IsHitTestVisible="False"/><TextBlock Text="buddy." FontSize="25" FontWeight="SemiBold" Margin="10,-5,0,0"/><TextBlock Text="SETUP" FontSize="9" Foreground="#686868" Margin="18,9,0,0"/></StackPanel><Button x:Name="MotionButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,39,0" Background="Transparent" Foreground="#686868" Padding="10,6" FontSize="9" Content="Pause motion" AutomationProperties.Name="Pause installer animation"/><Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="#686868" Padding="9,3" FontSize="17" Content="&#x00D7;" AutomationProperties.Name="Close setup"/></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.28*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock x:Name="Eyebrow" Text="WELCOME TO BUDDY" Foreground="#686868" FontSize="9" Margin="0,0,0,18"/><TextBlock x:Name="Heading" Text="A clearer space&#x0a;for your meetings." FontSize="35" FontWeight="Light" LineHeight="40"/><TextBlock x:Name="Description" Text="Record conversations, keep your notes,&#x0a;and return to what matters." FontSize="13" Foreground="#686868" LineHeight="23" Margin="0,19,0,0" TextWrapping="Wrap"/>
     </StackPanel>
     <Border x:Name="GlassHost" Grid.Column="1" VerticalAlignment="Center" Height="286" Margin="12,0,0,0" CornerRadius="22" AutomationProperties.Name="Animated refracted glass artwork"><Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.09" Color="#303030"/></Border.Effect></Border>
    </Grid>
    <Grid Grid.Row="2" Margin="0,17,0,0"><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="Status" FontSize="10" Foreground="#686868" TextWrapping="Wrap"/>
     <ProgressBar x:Name="Progress" Grid.Row="1" Height="3" Foreground="#5F5F5F" Background="#ECECEC" BorderThickness="0" Visibility="Hidden" Minimum="0" Maximum="100"/>
     <Grid Grid.Row="2" Margin="0,17,0,0"><TextBlock x:Name="Footnote" VerticalAlignment="Center" Text="No account needed. Your workspace stays on this device." FontSize="9" Foreground="#686868" MaxWidth="380" HorizontalAlignment="Left" TextWrapping="Wrap"/><Button x:Name="Primary" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="152" Content="Install Buddy   &#x2192;"/></Grid>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
