{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buddy",
  "version": "0.1.0",
  "identifier": "com.buddy.meeting",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Buddy — Meeting workspace",
        "width": 1180,
        "height": 760,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "icons/installer-dmg.png",
        "windowSize": {
          "width": 760,
          "height": 460
        },
        "appPosition": {
          "x": 220,
          "y": 224
        },
        "applicationFolderPosition": {
          "x": 540,
          "y": 224
        }
      }
    }
  }
}
